DATABASE_URL="file:./dev.db"

# Absolute base URL of this site — needed for Cashfree's return_url/notify_url,
# which must be full URLs. Use http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Long random string used to sign admin session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Admin sign-in is a one-time code emailed to this ONE address (no PIN/password).
# Only this address can ever receive a code. Codes work once and expire in 10 min.
ADMIN_LOGIN_EMAIL=arisenumero@gmail.com

# ── Email delivery — REQUIRED for the login code to reach a real inbox ──────────
# Easiest option: send through the Gmail account itself using an App Password.
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password:      https://myaccount.google.com/apppasswords
#      (a 16-character code — this is NOT your normal Gmail password)
#   3. Paste it below as SMTP_PASS (spaces optional), then run:  npm run test-email
# Without any email provider: in local dev the code is printed in the terminal;
# in production, admin login is disabled until one is configured.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=arisenumero@gmail.com
SMTP_PASS=
# Optional display name/address override (defaults to "Arise Numero <SMTP_USER>").
SMTP_FROM=

# Optional — only needed if you want real PayPal checkout in addition to the
# built-in Cash on Delivery / Bank Transfer flow (which always works with no setup).
# Get these from developer.paypal.com -> Apps & Credentials.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Optional — Cashfree Payment Gateway (UPI, GPay, Mastercard/Visa cards,
# netbanking, wallets — one integration covers all of these). Sign up at
# https://merchant.cashfree.com/merchants/signup — sandbox test keys are
# issued instantly with no KYC, from Developers -> API Keys (toggle to Test
# Mode). Set CASHFREE_MODE=production and use your live keys once KYC is
# approved.
CASHFREE_MODE=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Alternative to SMTP above — transactional email via Resend (used only if SMTP_* is not set).
# Get a free API key at https://resend.com. With its free onboarding sender
# (onboarding@resend.dev) mail can only be delivered to the address the Resend
# account was created with; verify your own domain to send to anyone.
RESEND_API_KEY=
EMAIL_FROM="Arise Numero <onboarding@resend.dev>"
# Where new-order/new-booking/new-message notifications get sent to you.
ADMIN_NOTIFY_EMAIL=

# ── Optional: footer links, analytics, newsletter ──────────────────────────────
# Social/contact links in the footer — only the ones you fill in are shown.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_PINTEREST_URL=
# WhatsApp number with country code, digits only (e.g. 919876543210) — adds a WhatsApp link.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Google Analytics 4 measurement id (looks like G-XXXXXXXXXX). Loaded ONLY after a
# visitor accepts analytics cookies in the cookie banner; nothing is sent before that.
NEXT_PUBLIC_GA_ID=

# Coupon code offered in the newsletter welcome email (used only if that coupon exists and is valid).
NEWSLETTER_WELCOME_COUPON=WELCOME10

# Search-engine ownership verification codes (see TODO.md section 11).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
